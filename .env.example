VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Platform root domain. Tenants are served from <slug>.<this domain>.
VITE_ROOT_DOMAIN=kakros.id

# DEV / PREVIEW ONLY: tenant used on hosts that are not under the root
# domain (plain localhost, *.pages.dev). Ignored on the real domain.
# You can also switch tenant on the fly with ?tenant=<slug> (or ?tenant=root
# to see the platform root page).
VITE_BUSINESS_ID=kak-ros-test
